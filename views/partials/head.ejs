<!-- ===== ส่วน <head> ใช้ร่วมทุกหน้า ===== -->
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | หม่าล่า Self Service</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">
  
  <!-- โหลด base.css เสมอ และโหลดไฟล์ css เฉพาะหน้าถ้ามีการระบุ -->
  <link rel="stylesheet" href="/css/base.css">
  <% if (typeof css !== 'undefined') { %>
  <link rel="stylesheet" href="/css/<%= css %>.css">
  <% } %>

  <% if (typeof refresh !== 'undefined' && refresh) { %>
  <meta http-equiv="refresh" content="<%= refresh %>">
  <% } %>
</head>