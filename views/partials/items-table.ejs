<!-- ===== ตารางรายการอาหารในออเดอร์ (ใช้ร่วมหน้าพนักงาน เช่น ครัว และ เคาน์เตอร์) ===== -->
<table class="items-table">
  <thead>
    <tr>
      <th>เมนู</th>
      <th class="r">จำนวน</th>
      <th class="r">ราคารวม</th>
    </tr>
  </thead>
  <tbody>
    <% order.items.forEach(function (it) { %>
    <tr>
      <td>
        <!-- ===== แสดงไอคอนหมวดหมู่ และ ชื่อเมนู ===== -->
        <%= CATEGORY_ICON[it.Category_Name] || '🍽️' %> <%= it.Menu_Name %>
        
        <!-- ===== แสดงระดับความเผ็ด (ถ้ามี) ===== -->
        <% if (it.Spiciness_Level) { %>
          <br><small class="o-items"><span class="spice">🌶 <%= it.Spiciness_Level %></span></small>
        <% } %>
        
        <!-- ===== แสดงหมายเหตุ (ถ้ามี) ===== -->
        <% if (it.Special_Note) { %>
          <br><small class="muted">หมายเหตุ: <%= it.Special_Note %></small>
        <% } %>
      </td>
      <td class="r"><%= it.Quantity %> ชุด</td>
      <td class="r"><%= baht(it.Subtotal) %> ฿</td>
    </tr>
    <% }) %>
  </tbody>
  <tfoot>
    <!-- ===== แถวสรุปยอดรวมราคาทั้งหมด ===== -->
    <tr>
      <td colspan="2">ยอดรวม</td>
      <td class="r"><%= baht(order.Total_Price) %> ฿</td>
    </tr>
  </tfoot>
</table>
