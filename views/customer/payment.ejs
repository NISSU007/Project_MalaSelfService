<%- include('../partials/head', {css: 'customer', title: 'ชำระเงิน' }) %>
<body>
<div class="phone">
  <%- include('../partials/customer-header') %>

  <!-- ===== หัวข้อหน้าชำระเงิน ===== -->
  <div class="page-top"><h2>ชำระเงิน</h2></div>

  <!-- ===== ยอดที่ต้องชำระ ===== -->
  <div class="pay-total">
    <span>ยอดที่ต้องชำระ</span>
    <strong><%= baht(order.Total_Price) %> บาท</strong>
  </div>

  <!-- ===== ตัวเลือกช่องทางชำระเงิน ===== -->
  <div class="pay-options">
    <a class="pay-opt <%= typeof method !== 'undefined' && method === 'qr' ? 'active' : '' %>" href="?method=qr">
      <span class="ico">🔳</span>QR Code<small>สแกน QR จ่ายเงิน</small>
    </a>
    <form method="post" action="/table/<%= table.Table_ID %>/payment/<%= order.Order_ID %>/cash" style="margin:0">
      <button class="pay-opt <%= typeof method !== 'undefined' && method === 'cash' ? 'active' : '' %>" type="submit">
        <span class="ico">💵</span>เงินสด<small>ชำระที่เคาน์เตอร์</small>
      </button>
    </form>
  </div>

  <% if (typeof method !== 'undefined' && method === 'qr') { %>
    <!-- ===== แสดง QR Code สำหรับสแกนจ่าย ===== -->
    <section class="pay-panel">
      <h3>สแกน QR Code</h3>
      <!-- ย้าย Form มาครอบกล่อง QR เพื่อใช้กดจำลองจ่าย -->
      <form id="qrPayForm" method="post" action="/table/<%= table.Table_ID %>/payment/<%= order.Order_ID %>/qr" style="margin-top:14px">
        <div class="qr-box" onclick="document.getElementById('qrPayForm').submit();" style="cursor: pointer;" title="คลิกที่นี่เพื่อจำลองการสแกนจ่าย">
          <img src="<%= qrImage %>" alt="QR Code สำหรับชำระเงิน">
          <div>
            <div class="muted">จำนวนเงิน</div>
            <div class="ref-big" style="font-size:24px"><%= baht(order.Total_Price) %> บาท</div>
            <div class="muted" style="margin-top:6px">รหัสอ้างอิง <%= order.Reference_Code %></div>
          </div>
        </div>
      </form>
      <!-- เพิ่มหมายเหตุการจำลองแสกนด้านล่าง -->
      <p class="muted" style="text-align: center; margin-top: 16px; font-size: 13px; color: #888;">
        * หมายเหตุ: กดที่ QR Code เพื่อจำลองการสแกน
      </p>
    </section>
  <% } else if (typeof method !== 'undefined' && method === 'cash') { %>
    <!-- ===== ข้อมูลสำหรับชำระเงินสดที่เคาน์เตอร์ ===== -->
    <section class="pay-panel">
      <h3>กรุณานำข้อมูลนี้ไปชำระที่เคาน์เตอร์</h3>
      <table class="info-table">
        <tr><td>หมายเลขโต๊ะ</td><td><%= table.Table_Number %></td></tr>
        <tr><td>เลขอ้างอิงการชำระเงิน</td><td class="ref-big"><%= order.Reference_Code %></td></tr>
        <tr><td>ยอดที่ต้องชำระ</td><td><%= baht(order.Total_Price) %> บาท</td></tr>
      </table>
      <p class="muted" style="margin:12px 0">แจ้งหมายเลขอ้างอิงการชำระเงินกับพนักงานแคชเชียร์</p>
    </section>
  <% } %>

  <!-- ===== นับเวลาถอยหลังก่อนเซสชันหมดอายุ ===== -->
  <% if (!hasPayment) { %>
    <p class="timer" id="timerBox">กรุณาเลือกช่องทางชำระเงินภายใน <b id="timer">--:--</b> นาที</p>
    <script>
      // ป้องกัน Error กรณีตัวแปร secondsLeft ไม่มีค่า
      let left = <%= typeof secondsLeft !== 'undefined' ? (secondsLeft || 0) : 0 %>;
      function tick() {
        if (left <= 0) {
          document.getElementById('timer').textContent = '00:00';
          alert('เซสชันการสั่งซื้อหมดอายุ');
          location.reload();
          return;
        }
        const m = String(Math.floor(left / 60)).padStart(2, '0');
        const s = String(left % 60).padStart(2, '0');
        document.getElementById('timer').textContent = m + ':' + s;
        left--;
        setTimeout(tick, 1000);
      }
      tick();
    </script>
  <% } %>

  <!-- ===== ตรวจจับการเปลี่ยนสถานะจากพนักงานแคชเชียร์อัตโนมัติ (Auto Redirect) ===== -->
  <script>
    (function() {
      const orderId = "<%= order.Order_ID %>";
      const tableId = "<%= table.Table_ID %>";
      const currentStatus = "<%= order.Order_Status %>";

      function checkPaymentStatus() {
        fetch('/api/order/' + orderId)
          .then(res => res.json())
          .then(data => {
            // เมื่อพนักงานแคชเชียร์อัปเดตสถานะ (เช่น เป็น 'กำลังเตรียมอาหาร' หรือ 'ชำระแล้ว')
            if (data.ok && data.status !== currentStatus) {
              window.location.href = '/table/' + tableId + '/order/' + orderId;
            }
          })
          .catch(err => console.error('Error checking status:', err));
      }

      // เช็คสถานะใหม่ทุกๆ 2.5 วินาที
      setInterval(checkPaymentStatus, 2500);
    })();
  </script>
</div>
</body>
</html>