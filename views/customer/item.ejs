<%- include('../partials/head', {css: 'customer', title: menu.Menu_Name }) %>
<body>
<div class="phone">
  <%- include('../partials/customer-header') %>

  <!-- ===== ฟอร์มเพิ่มลงตะกร้า ===== -->
  <form method="post" action="/table/<%= table.Table_ID %>/cart/add" id="itemForm">
    <input type="hidden" name="menuId" value="<%= menu.Menu_ID %>">
    <% if (editItem) { %><input type="hidden" name="detailId" value="<%= editItem.Order_Detail_ID %>"><% } %>

    <!-- ===== ปุ่มปิด (ขวาบน) ===== -->
    <div class="item-close-bar">
      <a class="close-x" href="<%= editItem ? '/table/' + table.Table_ID + '/cart' : '/table/' + table.Table_ID + '/menu?tab=' + backTab + '&cat=' + menu.Category_ID %>" aria-label="ปิด">✕</a>
    </div>

    <!-- ===== ชื่อเมนู + ปริมาณ (ซ้าย) และ ราคา (ขวา) อยู่ระดับเดียวกัน ===== -->
    <div class="item-top">
      <div class="item-title-wrap">
        <h2>
          <%= menu.Menu_Name %>
          <% if (menu.Serving_Qty && menu.Serving_Unit) { %>
            <span class="item-serving">(<%= menu.Serving_Qty %> <%= menu.Serving_Unit %>)</span>
          <% } %>
        </h2>
      </div>
      <div class="item-top-price"><%= baht(menu.Price) %> บาท</div>
    </div>

    <!-- ===== รูปเมนู ===== -->
    <div class="item-hero">
      <% if (menu.Image_URL) { %><img src="<%= menu.Image_URL %>" alt="<%= menu.Menu_Name %>"><% } else { %><%= CATEGORY_ICON[menu.Category_Name] %><% } %>
    </div>

    <div class="item-body">
      <% if (menu.Description) { %>
        <p class="item-desc"><%= menu.Description %></p>
      <% } %>

      <!-- ===== แจ้งเตือนข้อผิดพลาด (จากฝั่ง Server) ===== -->
      <% if (error === 'spice') { %>
        <div class="alert alert-red" id="serverSpiceAlert" role="alert">กรุณาเลือกระดับความเผ็ดก่อนเพิ่มลงตะกร้า</div>
      <% } else if (error === 'soup') { %>
        <div class="alert alert-red" role="alert">กรุณาเลือกน้ำซุปให้ครบทั้ง 2 ชนิด</div>
      <% } else if (error === 'samesoup') { %>
        <div class="alert alert-red" role="alert">ไม่สามารถเลือกประเภทน้ำซุปซ้ำกันได้</div>
      <% } else if (error === 'soldout' || menu.soldOut) { %>
        <div class="alert alert-red" role="alert">สินค้าหมด ไม่สามารถเลือกรายการนี้ได้</div>
      <% } %>

      <% if (menu.isSoup) { %>
        <!-- ===== ตัวเลือกระดับความเผ็ด ===== -->
        <div id="spiceContainer">
          <span class="field-label">เลือกระดับความเผ็ด <span class="req">* จำเป็น</span></span>
          <div class="spice-grid">
            <% spiceLevels.forEach(function (lv, i) { %>
              <div class="spice-opt">
                <!-- นำ required ออก เพื่อไม่ให้ขึ้น Tooltip ของเบราว์เซอร์ และใช้ Custom Alert แทน -->
                <input type="radio" name="spice" id="sp<%= i %>" value="<%= lv %>"
                  <%= editItem && editItem.Spiciness_Level === lv ? 'checked' : '' %>>
                <label for="sp<%= i %>">
                  <span class="chilis"><%= i === 0 ? '❌' : '🌶️'.repeat(i) %></span>
                  <%= lv %>
                </label>
              </div>
            <% }) %>
          </div>
        </div>
        
        <!-- ===== เลือก 2 น้ำซุป (กรณีชื่อเมนูมีเลข 2) ===== -->
        <% if (menu.Menu_Name.includes('2')) { %>
          <div style="margin-top: 16px;">
            <!-- น้ำซุปที่ 1 -->
            <label class="field-label" style="display: block; margin-bottom: 8px;">เลือกน้ำซุปที่ 1 <span class="req">* จำเป็น</span></label>
            <select name="soup1" class="note-input" style="height: 44px; margin-bottom: 12px; padding: 0 12px;" required>
              <option value="">-- กรุณาเลือกน้ำซุปที่ 1 --</option>
              <option value="น้ำซุปหม่าล่าดั้งเดิม" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปหม่าล่าดั้งเดิม' ? 'selected' : '' %>>น้ำซุปหม่าล่าดั้งเดิม</option>
              <option value="น้ำซุปหม่าล่าต้มยำ" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปหม่าล่าต้มยำ' ? 'selected' : '' %>>น้ำซุปหม่าล่าต้มยำ</option>
              <option value="น้ำซุปหม่าล่านม" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปหม่าล่านม' ? 'selected' : '' %>>น้ำซุปหม่าล่านม</option>
              <option value="น้ำซุปใส" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปใส' ? 'selected' : '' %>>น้ำซุปใส</option>
              <option value="น้ำซุปกระดูกหมู" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปกระดูกหมู' ? 'selected' : '' %>>น้ำซุปกระดูกหมู</option>
              <option value="น้ำซุปดำ" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[0] === 'น้ำซุปดำ' ? 'selected' : '' %>>น้ำซุปดำ</option>
            </select>

            <!-- น้ำซุปที่ 2 -->
            <label class="field-label" style="display: block; margin-bottom: 8px;">เลือกน้ำซุปที่ 2 <span class="req">* จำเป็น</span></label>
            <select name="soup2" class="note-input" style="height: 44px; margin-bottom: 8px; padding: 0 12px;" required>
              <option value="">-- กรุณาเลือกน้ำซุปที่ 2 --</option>
              <option value="น้ำซุปหม่าล่าดั้งเดิม" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปหม่าล่าดั้งเดิม' ? 'selected' : '' %>>น้ำซุปหม่าล่าดั้งเดิม</option>
              <option value="น้ำซุปหม่าล่าต้มยำ" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปหม่าล่าต้มยำ' ? 'selected' : '' %>>น้ำซุปหม่าล่าต้มยำ</option>
              <option value="น้ำซุปหม่าล่านม" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปหม่าล่านม' ? 'selected' : '' %>>น้ำซุปหม่าล่านม</option>
              <option value="น้ำซุปใส" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปใส' ? 'selected' : '' %>>น้ำซุปใส</option>
              <option value="น้ำซุปกระดูกหมู" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปกระดูกหมู' ? 'selected' : '' %>>น้ำซุปกระดูกหมู</option>
              <option value="น้ำซุปดำ" <%= editItem && editItem.Soup_Type && editItem.Soup_Type.split(' + ')[1] === 'น้ำซุปดำ' ? 'selected' : '' %>>น้ำซุปดำ</option>
            </select>
          </div>
        <% } %>

        <input type="hidden" name="qty" value="1">
      <% } else { %>
        <!-- ===== ตัวเลือกจำนวน ===== -->
        <div class="qty">
          <button type="button" onclick="changeQty(-1)" aria-label="ลดจำนวน">−</button>
          <span class="qty-num" id="qtyText"><%= editItem ? editItem.Quantity : 1 %></span>
          <button type="button" onclick="changeQty(1)" aria-label="เพิ่มจำนวน">+</button>
        </div>
        <div class="qty-label-bottom">เลือกจำนวน</div>
        <input type="hidden" name="qty" id="qtyInput" value="<%= editItem ? editItem.Quantity : 1 %>">
      <% } %>

      <!-- ===== หมายเหตุ ===== -->
      <label class="field-label" for="note" style="margin-top: 16px; display: block;">หมายเหตุ (ถ้ามี)</label>
      <textarea class="note-input" id="note" name="note" rows="2" placeholder="เช่น ไม่ใส่ผักชี"><%= editItem ? editItem.Special_Note : '' %></textarea>
    </div>

    <!-- ===== ปุ่มเพิ่มลงตะกร้า ===== -->
    <div class="bottom-bar">
      <button class="bar-btn" type="submit" id="submitCartBtn" <%= menu.soldOut ? 'disabled' : '' %>>
        <span><%= editItem ? 'บันทึกการแก้ไข' : 'เพิ่มลงตะกร้า' %></span>
        <span><span id="priceText"><%= baht(menu.Price * (editItem ? editItem.Quantity : 1)) %></span> บาท</span>
      </button>
    </div>
  </form>
</div>

<!-- ===== สคริปต์ตรวจสอบซุปซ้ำ + ปรับจำนวน / ราคา ===== -->
<script>
  const unitPrice = <%= menu.Price %>;
  function changeQty(step) {
    const input = document.getElementById('qtyInput');
    let qty = parseInt(input.value) + step;
    if (qty < 1) qty = 1;
    if (qty > 99) qty = 99;
    input.value = qty;
    document.getElementById('qtyText').textContent = qty;
    document.getElementById('priceText').textContent = (qty * unitPrice).toLocaleString('th-TH');
  }

  document.addEventListener('DOMContentLoaded', function() {
    const itemForm = document.getElementById('itemForm');
    const soup1 = document.querySelector('select[name="soup1"]');
    const soup2 = document.querySelector('select[name="soup2"]');

    // ฟังก์ชันซ่อนแจ้งเตือนน้ำซุปซ้ำเมื่อผู้ใช้เปลี่ยนค่าใหม่
    function hideSoupAlert() {
      const alertBox = document.getElementById('clientSoupAlert');
      if (alertBox) alertBox.style.display = 'none';
    }

    // ฟังก์ชันซ่อน/แสดง เลือกระดับความเผ็ด
    function updateSpiceVisibility() {
      const spiceContainer = document.getElementById('spiceContainer');
      if (!spiceContainer) return;

      const menuName = "<%= menu.Menu_Name %>";
      
      const isNonSpicy = (name) => {
        if (!name) return false;
        // จับคู่คำว่า 'ใส', 'กระดูกหมู', 'ดำ' เพื่อซ่อนระดับความเผ็ด
        return name.includes('ใส') || name.includes('กระดูกหมู') || name.includes('ดำ');
      };

      let requireSpice = true;

      if (soup1 && soup2) {
        const val1 = soup1.value;
        const val2 = soup2.value;

        if (val1 !== "" || val2 !== "") {
          const s1Spicy = val1 !== "" && !isNonSpicy(val1);
          const s2Spicy = val2 !== "" && !isNonSpicy(val2);
          requireSpice = s1Spicy || s2Spicy;
        }
      } else {
        if (isNonSpicy(menuName)) {
          requireSpice = false;
        }
      }

      const radios = spiceContainer.querySelectorAll('input[type="radio"]');
      if (requireSpice) {
        spiceContainer.style.display = 'block';
      } else {
        spiceContainer.style.display = 'none';
        
        // เลือกตัวเลือกระดับแรกสุดอัตโนมัติ (เช่น ❌ ไม่เผ็ด) เพื่อส่งค่าไปที่ Backend ไม่ให้เกิด Error
        if (radios.length > 0) {
          radios[0].checked = true;
        }
        
        // ซ่อน Alert ฝั่ง Client หากมีค้างอยู่
        const alertBox = document.getElementById('clientSpiceAlert');
        if (alertBox) alertBox.style.display = 'none';

        // ซ่อน Alert ฝั่ง Server ถ้ามีแจ้งเตือนค้างอยู่
        const serverAlert = document.getElementById('serverSpiceAlert');
        if (serverAlert) serverAlert.style.display = 'none';
      }
    }

    if (itemForm) {
      if (soup1 && soup2) {
        // เมื่อมีการเปลี่ยนซุป ให้ซ่อนแจ้งเตือนแล้วเช็คความเผ็ดใหม่
        soup1.addEventListener('change', () => { hideSoupAlert(); updateSpiceVisibility(); });
        soup2.addEventListener('change', () => { hideSoupAlert(); updateSpiceVisibility(); });
      }

      // เช็คซ้ำและตรวจสอบความเผ็ดตอนกดปุ่ม submit
      itemForm.addEventListener('submit', function(e) {
        // 1. ตรวจสอบน้ำซุปซ้ำกัน (Custom Alert)
        if (soup1 && soup2) {
          let soupAlert = document.getElementById('clientSoupAlert');
          if (soupAlert) soupAlert.style.display = 'none';

          if (soup1.value !== "" && soup2.value !== "" && soup1.value === soup2.value) {
            e.preventDefault(); // หยุดการทำงานของฟอร์ม
            
            if (!soupAlert) {
              soupAlert = document.createElement('div');
              soupAlert.id = 'clientSoupAlert';
              soupAlert.className = 'alert alert-red';
              soupAlert.setAttribute('role', 'alert');
              soupAlert.style.marginBottom = '16px';
              soupAlert.textContent = 'ไม่สามารถเลือกประเภทน้ำซุปซ้ำกันได้ กรุณาเลือกน้ำซุปที่ต่างกัน';
              
              // แทรกกล่องแจ้งเตือนไว้ใต้ช่องเลือกน้ำซุปที่ 2
              soup2.parentNode.insertBefore(soupAlert, soup2.nextSibling);
            }
            
            soupAlert.style.display = 'block';
            soupAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // หยุดการตรวจสอบอื่นต่อเพื่อให้โฟกัสที่การแก้ซุปก่อน
            return; 
          }
        }

        // 2. ตรวจสอบว่าเลือกระดับความเผ็ดหรือยัง (ถ้าต้องเลือก)
        const spiceContainer = document.getElementById('spiceContainer');
        let spiceAlert = document.getElementById('clientSpiceAlert');
        if (spiceAlert) spiceAlert.style.display = 'none';

        if (spiceContainer && spiceContainer.style.display !== 'none') {
          const isChecked = spiceContainer.querySelector('input[type="radio"]:checked');
          if (!isChecked) {
            e.preventDefault(); // หยุดการทำงานของฟอร์ม
            
            // สร้างกล่องแจ้งเตือนใหม่หากยังไม่มี
            if (!spiceAlert) {
              spiceAlert = document.createElement('div');
              spiceAlert.id = 'clientSpiceAlert';
              spiceAlert.className = 'alert alert-red';
              spiceAlert.setAttribute('role', 'alert');
              spiceAlert.style.marginBottom = '16px';
              spiceAlert.textContent = 'กรุณาเลือกระดับความเผ็ดก่อนเพิ่มลงตะกร้า';
              spiceContainer.parentNode.insertBefore(spiceAlert, spiceContainer);
            }
            spiceAlert.style.display = 'block';
            spiceAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      });

      updateSpiceVisibility();
    }
  });
</script>
</body>
</html>