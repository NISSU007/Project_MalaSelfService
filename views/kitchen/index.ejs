<%- include('../partials/head', {css: 'kitchen', title: 'ออเดอร์ที่ต้องปรุง', refresh: 0 }) %>
<body>
<div class="staff">
  <%- include('../partials/staff-top', { roleLabel: 'ครัว' }) %>

  <main class="s-main">
    <!-- ===== หัวข้อหน้าครัว ===== -->
    <h1 class="s-title">ออเดอร์ที่ต้องปรุง</h1>

    <% if (success) { %><div class="alert alert-green" role="status">✔ ออเดอร์ #<%= success %> ปรุงเสร็จสิ้น ส่งไปหน้าเคาน์เตอร์แล้ว</div><% } %>

    <!-- ===== แถบตัวกรองสถานะ + ช่องค้นหา (สไตล์เคาน์เตอร์) ===== -->
    <div class="kitchen-toolbar">
      <div class="kitchen-tabs">
        <a href="?tab=preparing&q=<%= q %>" class="kitchen-tab preparing-tab <%= tab === 'preparing' ? 'active' : '' %>">
          📋 กำลังเตรียม <b><%= counts.preparing %></b> <span>ออเดอร์</span>
        </a>
        <a href="?tab=cooked&q=<%= q %>" class="kitchen-tab cooked-tab <%= tab === 'cooked' ? 'active' : '' %>">
          🍲 ปรุงเสร็จสิ้น <b><%= counts.cooked %></b> <span>ออเดอร์</span>
        </a>
        <a href="?tab=done&q=<%= q %>" class="kitchen-tab done-tab <%= tab === 'done' ? 'active' : '' %>">
          ✅ เสร็จสิ้นวันนี้ <b><%= counts.done %></b> <span>ออเดอร์</span>
        </a>
      </div>

      <form class="kitchen-search" method="get">
        <input type="hidden" name="tab" value="<%= tab %>">
        <input type="search" name="q" value="<%= q %>" placeholder="🔍 ค้นหาเลขออเดอร์" aria-label="ค้นหาเลขออเดอร์">
      </form>
    </div>

    <% if (list.length === 0) { %>
      <!-- ===== กรณีไม่มีออเดอร์ (แสดงผลเต็มหน้าจอ) ===== -->
      <div class="empty-order" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 350px; background: #ffffff; border: 2px dashed #d0d0d0; border-radius: 20px; margin-top: 20px; text-align: center; padding: 40px 20px; box-sizing: border-box;">
        <div class="empty-icon" style="font-size: 50px; margin-bottom: 12px; opacity: 0.6;">🍽️</div>
        <p style="font-size: 16px; font-weight: 500; color: #888; margin: 0;">ไม่มีออเดอร์ในขณะนี้</p>
      </div>
    <% } else { %>
      <!-- ===== แสดงรายการออเดอร์ (เมื่อมีข้อมูล) ===== -->
      <div class="s-layout <%= selected ? 'has-side' : '' %>">

        <!-- ===== การ์ดออเดอร์ (เรียงตามเวลา) ===== -->
        <section class="order-grid">
          <% list.forEach(function (o) { %>
            <a class="o-card <%= selected && selected.Order_ID === o.Order_ID ? 'selected' : '' %>" href="?tab=<%= tab %>&q=<%= q %>&id=<%= o.Order_ID %>">
              <div class="o-card-head">
                <span class="o-no"><%= orderNo(o.Reference_Code) %></span>
                <span class="muted"><%= o.Order_Time %> น.</span>
              </div>
              <div class="o-meta"><span>โต๊ะ <%= o.Table_Number %></span><span><%= o.Item_Count %> รายการ</span></div>
              <% if (tab === 'all') { %><span class="badge <%= o.Order_Status === STATUS.PREPARING ? 'badge-amber' : 'badge-green' %>"><%= o.Order_Status %></span><% } %>
              <ul class="o-items">
                <% o.items.forEach(function (it) { %>
                  <li>
                    <span>• <%= it.Menu_Name %> <% if (it.Spiciness_Level) { %><span class="spice">🌶 <%= it.Spiciness_Level %></span><% } %></span>
                    <span>x<%= it.Quantity %></span>
                  </li>
                <% }) %>
              </ul>
              <% var notes = o.items.filter(function (it) { return it.Special_Note; }); %>
              <span class="o-note">หมายเหตุ : <%= notes.length ? notes.map(function (n) { return n.Menu_Name + ' - ' + n.Special_Note; }).join(', ') : 'ไม่มี' %></span>
            </a>
          <% }) %>
        </section>

        <!-- ===== แผงรายละเอียดออเดอร์ที่เลือก ===== -->
        <% if (selected) { %>
          <aside class="panel">
            <div class="detail-head" style="display:flex; flex-direction:column; gap:4px">
              <div style="display:flex; justify-content:space-between; align-items:center; width:100%">
                <div class="muted">รายละเอียดออเดอร์ · โต๊ะ <%= selected.Table_Number %></div>
                <a class="close-x" href="?tab=<%= tab %>" aria-label="ปิด">✕</a>
              </div>

              <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;">
                <div>
                  <span class="o-no"><%= orderNo(selected.Reference_Code) %></span>
                </div>
                <div class="muted" style="text-align: right; font-size: 0.9em; line-height: 1.3; margin-left: auto;">
                  <div>🕒 <%= selected.Order_Time %> น.</div>
                  <div><%= selected.Order_Date %></div>
                </div>
              </div>
            </div>

            <%- include('../partials/items-table', { order: selected }) %>

            <!-- ===== ปุ่มอัปเดตสถานะ / พิมพ์ใบเสร็จ ===== -->
            <div style="display:flex; flex-direction:column; gap:8px; margin-top:14px; width:100%;">
              <% if (selected.Order_Status === 'กำลังเตรียมอาหาร') { %>
                <a class="btn btn-amber" style="width:100%; text-align:center; box-sizing:border-box;" href="/kitchen/status?id=<%= selected.Order_ID %>">อัปเดตสถานะ</a>
              <% } %>
              <a class="btn btn-red" style="width:100%; text-align:center; box-sizing:border-box;" href="/kitchen/print/<%= selected.Order_ID %>" target="_blank">🖨️ พิมพ์ใบเสร็จ</a>
            </div>
          </aside>
        <% } %>

      </div>
    <% } %>
  </main>
</div>

<!-- สคริปต์อัปเดตออเดอร์แบบเรียลไทม์ (Polling) -->
<script>
  (function() {
    setInterval(function() {
      fetch(window.location.href)
        .then(res => res.text())
        .then(html => {
          const doc = new DOMParser().parseFromString(html, 'text/html');

          // 1. อัปเดตตัวเลขจำนวนออเดอร์ในแท็บด้านบน
          const currentTabs = document.querySelector('.kitchen-tabs');
          const newTabs = doc.querySelector('.kitchen-tabs');
          if (currentTabs && newTabs) {
            currentTabs.innerHTML = newTabs.innerHTML;
          }

          // 2. ตรวจสอบการเปลี่ยนแปลงของโครงสร้างหลัก (จากไม่มีออเดอร์ -> มีออเดอร์ หรือตรงข้ามกัน)
          const currentEmpty = document.querySelector('.empty-order');
          const newEmpty = doc.querySelector('.empty-order');
          const currentGrid = document.querySelector('.order-grid');
          const newGrid = doc.querySelector('.order-grid');

          if ((currentEmpty && newGrid) || (currentGrid && newEmpty)) {
            // โครงสร้างหน้าจอเปลี่ยนไป (เช่น ออเดอร์แรกเข้ามา หรือทำออเดอร์หมดเกลี้ยงแล้ว) ให้โหลดหน้าใหม่เพื่อความสมบูรณ์
            window.location.reload();
            return;
          }

          // 3. อัปเดตรายการการ์ดออเดอร์แบบเรียลไทม์ โดยรักษาตำแหน่งการ Scroll
          if (currentGrid && newGrid) {
            // เช็คว่าถ้ากำลังเปิดดูรายละเอียดออเดอร์อยู่ แล้วออเดอร์นั้นถูกเพื่อนทำเสร็จไปแล้ว (หายจาก List ปัจจุบัน)
            const currentSelected = currentGrid.querySelector('.o-card.selected');
            if (currentSelected) {
              const selectedHref = currentSelected.getAttribute('href');
              const isStillExist = newGrid.querySelector(`.o-card[href="${selectedHref}"]`);
              if (!isStillExist) {
                window.location.reload(); // รีเฟรชเพื่อปิดแถบด้านข้าง
                return;
              }
            }

            const scrollTop = currentGrid.scrollTop; // เก็บค่าที่ Scroll ไว้
            currentGrid.innerHTML = newGrid.innerHTML; // อัปเดตข้อมูลการ์ดทั้งหมด
            currentGrid.scrollTop = scrollTop;         // คืนค่า Scroll ให้ไม่เด้งกลับไปด้านบน
          }
        })
        .catch(err => console.error('Real-time update error:', err));
    }, 1000); // ดึงข้อมูลออเดอร์ใหม่ทุกๆ 1 วินาที
  })();
</script>

</body>
</html>